BoxLayout:
    orientation: "vertical"

    Label:
        text: "[b]00[/b]:00:00"
        font_size: 60
        markup: True

    BoxLayout:
        orientation: "horizontal"
        padding: 20
        spacing: 20
        height: 90
        size_hint: (1, None)

        Button:
            text: "Start"
            font_size: 25
            bold: True
            background_normal: ''

        Button:
            text: "Reset"
            font_size: 25
            bold: True        

    Label:
        text: '00:00.[size=40]00[/size]'
        font_size: 60
        markup: True
